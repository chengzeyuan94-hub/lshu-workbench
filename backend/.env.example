# L叔工作台 v0.1 — 本地配置模板
# 复制为 backend/.env.local；该文件已被 Git 忽略，权限应为 0600。
# 不要把真实 token、聊天内容、财务数据库或个人绝对路径提交到仓库。

# 核心运行
PORT=3456
WORKBENCH_DEMO_MODE=true
DISABLE_SCHEDULERS=1
# WORKBENCH_DATA_DIR=/absolute/private/path
# WORKBENCH_SCAN_ROOT=/absolute/path/to/a/folder

# 小红书（可选；未配置时使用明确标记的虚构演示账号）
XHS_ACCOUNT_KEY=
XHS_DISPLAY_NAME=
OPENCLI_BIN=opencli

# 飞书 CLI（可选；需在本机自行授权）
LARK_CLI_BIN=lark-cli

# 热点数据（可选）
CIMIDATA_APP_ID=
CIMIDATA_APP_SECRET=
CIMIDATA_BASE_URL=https://www.cimidata.com/

# 本地知识库适配器（可选；服务本身不随本仓库发布）
KNOWLEDGE_BASE_URL=http://127.0.0.1:8765
KNOWLEDGE_BASE_ROOT=

# DeepSeek（可选；只有在 UI 明确开启 AI 后才使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_BATCH_SIZE=20
DEEPSEEK_MAX_INPUT_CHARS=12000
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_MAX_ITEMS_PER_RUN=100
DEEPSEEK_DAILY_MAX_INPUT_TOKENS=250000
DEEPSEEK_DAILY_MAX_OUTPUT_TOKENS=50000
DEEPSEEK_DAILY_MAX_ESTIMATED_USD=0.10
DEEPSEEK_BUDGET_TIMEZONE=Asia/Shanghai

# MoneyCats 财务备份（可选；不经过 AI）
# MONEYCATS_DB_PATH=/absolute/path/to/moneycats_backup.db/user_database.db
# MONEYCATS_ALLOWED_ROOT=/absolute/path/to/the/allowed/Documents/folder

# 天气与城市级反向定位（可选）
WEATHER_ENABLED=true
LOCATION_REVERSE_ENABLED=true
LOCATION_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
LOCATION_REVERSE_USER_AGENT=LocalCreatorWorkbench/0.1
